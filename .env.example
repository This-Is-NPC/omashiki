# Omashiki environment. Copy to `.env` and edit:
#
#   cp .env.example .env
#
# `.env` is gitignored; this file is not, so it must never hold a real value.
# `mise` loads `.env` into the environment of every `mise run` task, and
# `${env:VAR}` references in omashiki.toml resolve against it at config load.
#
# A `${env:VAR}` whose variable is unset or empty aborts the boot naming the
# variable. That is deliberate: a missing key fails loudly at startup instead of
# turning into a 401 in the middle of somebody's attempt.

# --- Node identity ---------------------------------------------------------
# Which of the declared [nodes.*] this machine is. Falls back to the hostname,
# so a machine named after its host can leave this unset. Booting on a machine
# that is in no declared node fails config load.
# OMASHIKI_NODE=builder-01

# --- HTTP and database -----------------------------------------------------
# Override [app].port and [db].port from omashiki.toml.
# PORT=4010
# OMASHIKI_DB_PORT=5442

# Point a node at a PostgreSQL that is not on its own localhost. Single-node
# installs leave all four unset and get the Compose defaults.
# OMASHIKI_DB_HOST=10.0.0.10
# OMASHIKI_DB_USER=postgres
# OMASHIKI_DB_PASSWORD=
# OMASHIKI_DB_NAME=omashiki_dev

# Connection pool. Raise the pool before load testing: the default 10 is
# exhausted well before the container limit is, and a queue timeout surfaces as
# a 500 on job submission rather than as backpressure.
# POOL_SIZE=10
# POOL_QUEUE_TARGET=50
# POOL_QUEUE_INTERVAL=1000

# --- Model access ----------------------------------------------------------
# Referenced by [credentials.*] as `api_key = "${env:OPENROUTER_API_KEY}"`.
# Required by the load-test block that ships in the tracked omashiki.toml, so
# an unedited checkout needs it set to boot.
# OPENROUTER_API_KEY=

# Base URL of a model server on your LAN. A private address has no business in
# a git-tracked file, so it is an env reference like the key is.
# OMASHIKI_LOCAL_LLM_BASE_URL=http://10.0.0.20:8080/v1
# OMASHIKI_LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Git push credential ---------------------------------------------------
# Passphrase for [repositories.*].ssh_key. Host-side fetch and push only; it is
# never copied into a container. Plaintext in omashiki.toml is rejected at load,
# so this reference is the only way to declare it.
# OMASHIKI_GIT_KEY_PASSPHRASE=

# --- Runtime tuning (advanced) ---------------------------------------------
# Read by server/config/runtime.exs before the core is up.
# OMASHIKI_AGENT_NETWORK_MODE=bridge
# OMASHIKI_AGENT_TMP_SIZE_MB=512
# OMASHIKI_SUPPLY_CHAIN_NETWORK=
# OMASHIKI_LLM_EGRESS_HOSTS=
