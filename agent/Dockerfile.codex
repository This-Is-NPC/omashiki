# syntax=docker/dockerfile:1
# OpenAI Codex CLI 0.149.1 agent sandbox, using the same hardened base as OpenCode.
ARG OMATERM_BASE=ghcr.io/omacom-io/omaterm@sha256:180f5884ab8573b1235595eeefef605ad10ffdfbdef9eb96dfebd801e0f9215a

# The global npm install unpacks every @openai/codex platform vendor tree into
# the mise-managed node prefix. Copying the one matching vendor dir out
# afterwards does not reclaim the rest, so the install runs in its own stage
# and only the selected binaries cross into the final image.
FROM ${OMATERM_BASE} AS codex-build

ARG CODEX_VERSION=0.149.1

USER 1000
RUN mise trust /home/omaterm/.config/mise/config.toml \
    && npm install --global --no-fund --no-audit "@openai/codex@${CODEX_VERSION}" \
    && codex --version | grep -F "${CODEX_VERSION}" \
    && CODEX_VENDOR_BIN="$(dirname "$(find "$(npm root --global)/@openai" -type f -path '*/vendor/*/bin/codex' | head -1)")" \
    && test -x "${CODEX_VENDOR_BIN}/codex" \
    && mkdir -p /tmp/omashiki-codex-bin \
    && cp -a "${CODEX_VENDOR_BIN}/." /tmp/omashiki-codex-bin/ \
    && install -m 0755 "$(mise which node)" /tmp/omashiki-node-bin

FROM ${OMATERM_BASE}

ARG CODEX_VERSION=0.149.1

USER root
COPY --from=codex-build /tmp/omashiki-codex-bin/ /usr/local/bin/
COPY --from=codex-build /tmp/omashiki-node-bin /usr/local/bin/node
RUN chmod 0755 /usr/local/bin/node /usr/local/bin/codex \
    && /usr/local/bin/node --version \
    && /usr/local/bin/codex --version | grep -F "${CODEX_VERSION}"
COPY codex_runner.mjs /usr/local/bin/omashiki-codex-runner
COPY codex_entrypoint.sh /usr/local/bin/omashiki-codex-entrypoint
RUN chmod 0755 /usr/local/bin/omashiki-codex-runner /usr/local/bin/omashiki-codex-entrypoint

ENV PATH="/usr/local/bin:${PATH}"

USER 1000:1000
ENTRYPOINT ["/usr/local/bin/omashiki-codex-entrypoint"]
