{
  "openapi": "3.1.0",
  "info": {
    "title": "Omashiki Queue API",
    "version": "1.0.0",
    "description": "Authenticated queue admission and job runtime operations. Clients own jobs through the submitting bearer token; the local operator can inspect jobs owned by that operator."
  },
  "servers": [{"url": "/api/v1"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "responses": {"200": {"description": "Service is healthy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}
      }
    },
    "/repositories": {
      "get": {"responses": {"200": {"$ref": "#/components/responses/DataRepositories"}, "401": {"$ref": "#/components/responses/Error"}}}
    },
    "/environments": {
      "get": {"responses": {"200": {"$ref": "#/components/responses/DataEnvironments"}, "401": {"$ref": "#/components/responses/Error"}}}
    },
    "/jobs": {
      "get": {
        "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Status"}],
        "responses": {"200": {"$ref": "#/components/responses/DataJobs"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}}
      },
      "post": {
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitJob"}}}},
        "responses": {"202": {"$ref": "#/components/responses/DataJob"}, "401": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/jobs/batch": {
      "post": {
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitBatch"}}}},
        "responses": {"202": {"$ref": "#/components/responses/DataJobs"}, "401": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/jobs/{id}": {
      "parameters": [{"$ref": "#/components/parameters/JobId"}],
      "get": {"responses": {"200": {"$ref": "#/components/responses/DataJob"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/jobs/{id}/result": {
      "get": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "responses": {"200": {"$ref": "#/components/responses/DataResult"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/jobs/{id}/cancel": {
      "post": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "responses": {"200": {"$ref": "#/components/responses/DataJob"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/jobs/{id}/retry": {
      "post": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "responses": {"202": {"$ref": "#/components/responses/DataJob"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/jobs/{id}/events": {
      "get": {"parameters": [{"$ref": "#/components/parameters/JobId"}, {"$ref": "#/components/parameters/LastEventId"}], "responses": {"200": {"description": "Replayable SSE stream", "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/jobs/{id}/events/stream": {
      "get": {"parameters": [{"$ref": "#/components/parameters/JobId"}, {"$ref": "#/components/parameters/LastEventId"}], "responses": {"200": {"description": "Replayable SSE stream", "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/jobs/{id}/events/history": {
      "get": {"parameters": [{"$ref": "#/components/parameters/JobId"}, {"$ref": "#/components/parameters/LastEventId"}], "responses": {"200": {"description": "Durable event history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DataEvents"}}}}, "400": {"$ref": "#/components/responses/Error"}}}
    },
    "/jobs/{id}/webhook-deliveries": {
      "get": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "responses": {"200": {"description": "Operator-safe webhook delivery status", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"type": "object"}}}}}}}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "parameters": {
      "JobId": {"in": "path", "name": "id", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "Limit": {"in": "query", "name": "limit", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
      "Status": {"in": "query", "name": "status", "schema": {"type": "string", "enum": ["blocked", "queued", "provisioning", "running", "succeeded", "failed", "cancelled"]}},
      "LastEventId": {"in": "header", "name": "Last-Event-ID", "schema": {"type": "string", "format": "uuid"}}
    },
    "responses": {
      "Error": {"description": "Stable API error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "DataJob": {"description": "Job", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DataJob"}}}},
      "DataJobs": {"description": "Jobs", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DataJobs"}}}},
      "DataResult": {"description": "Terminal result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DataResult"}}}},
      "DataRepositories": {"description": "Registered repositories", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DataRepositories"}}}},
      "DataEnvironments": {"description": "Registered environments", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DataEnvironments"}}}}
    },
    "schemas": {
      "Health": {"type": "object", "required": ["status"], "properties": {"status": {"const": "ok"}}},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message", "details"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object", "additionalProperties": true}}}}},
      "Job": {"type": "object", "required": ["id", "status", "attempt", "idempotency_key", "repo", "environment"], "properties": {"id": {"type": "string", "format": "uuid"}, "schema_version": {"type": "integer"}, "idempotency_key": {"type": "string"}, "correlation_id": {"type": "string"}, "repo": {"type": "string"}, "environment": {"type": "string"}, "payload": {}, "priority": {"type": "integer", "minimum": 0, "maximum": 3}, "status": {"type": "string"}, "attempt": {"type": "integer", "minimum": 1}, "parent_job_id": {"type": ["string", "null"], "format": "uuid"}, "submitted_at": {"type": ["string", "null"], "format": "date-time"}, "queued_at": {"type": ["string", "null"], "format": "date-time"}, "started_at": {"type": ["string", "null"], "format": "date-time"}, "finished_at": {"type": ["string", "null"], "format": "date-time"}}},
      "DataJob": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/Job"}}},
      "DataJobs": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Job"}}}},
      "SubmitJob": {"type": "object", "required": ["schema_version", "idempotency_key", "correlation_id", "repo", "environment", "payload", "priority"], "properties": {"schema_version": {"const": 1}, "idempotency_key": {"type": "string", "minLength": 1}, "correlation_id": {"type": "string", "minLength": 1}, "repo": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "payload": {}, "priority": {"type": "integer", "minimum": 0, "maximum": 3}}},
      "SubmitBatch": {"type": "object", "required": ["schema_version", "correlation_id", "jobs"], "properties": {"schema_version": {"const": 1}, "correlation_id": {"type": "string", "minLength": 1}, "jobs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object"}}}},
      "Result": {"type": "object", "properties": {"job_id": {"type": "string", "format": "uuid"}, "attempt": {"type": "integer"}, "status": {"type": "string"}, "result": {}, "error": {}, "finished_at": {"type": ["string", "null"], "format": "date-time"}}},
      "DataResult": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/Result"}}},
      "Event": {"type": "object", "required": ["event_id", "job_id", "sequence", "status"], "properties": {"event_id": {"type": "string", "format": "uuid"}, "job_id": {"type": "string", "format": "uuid"}, "attempt": {"type": "integer"}, "sequence": {"type": "integer"}, "type": {"type": "string"}, "status": {"type": "string"}, "data": {"type": "object"}}},
      "DataEvents": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Event"}}}},
      "Repository": {"type": "object", "required": ["name", "base_branch"], "properties": {"name": {"type": "string"}, "base_branch": {"type": "string"}}},
      "Environment": {"type": "object", "required": ["name", "runtime", "image", "harness"], "properties": {"name": {"type": "string"}, "runtime": {"type": "string"}, "image": {"type": "string"}, "harness": {"type": "string"}, "timeout_ms": {"type": "integer"}, "network": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}}, "resources": {"type": "object"}}},
      "DataRepositories": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Repository"}}}},
      "DataEnvironments": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Environment"}}}}
    }
  }
}
