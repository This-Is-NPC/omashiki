#!/usr/bin/env python3
#MISE description="Run the Phoenix server in the foreground"
#MISE depends=["migrate", "assets-install", "images"]
import os
import socket
import sys
import pathlib

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / ".scripts"))
from omashiki import config, mix, node_cookie, node_name


def already_listening(host: str, port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.settimeout(0.5)
        return probe.connect_ex((host, port)) == 0


cfg = config()
host = cfg.get("app", {}).get("host", "127.0.0.1")
port = int(cfg.get("app", {}).get("port", 4000))

# Running `up` against an app that is already up has to be harmless. Without
# this the endpoint fails with :eaddrinuse.
if already_listening(host, port):
    print(f"✔ already running at http://{host}:{port} — nothing to do", flush=True)
    sys.exit(0)

# The database outlives this process: it stops only with `mise run stop`.
# Stopping it on exit raced a quick restart, where the old process's cleanup
# took the database down while the new one was migrating.
#
# Print the attach line rather than leaving it to be rediscovered. The whole
# point of naming the node is that someone can reach a wedged process without
# first working out what the node is called.
print(
    f"✔ node {node_name()} — attach a remote console with:\n"
    f"    iex --name console@127.0.0.1 --cookie {node_cookie()} --remsh {node_name()}",
    flush=True,
)

# A manager runs no job itself. Without the worker token no worker can poll it,
# and every admitted job would wait in the queue with nothing to say why.
if os.environ.get("OMASHIKI_ROLE") == "manager":
    print("✔ manager only — jobs run on workers (mise run up:worker)", flush=True)

    if not os.environ.get("OMASHIKI_WORKER_TOKEN", "").strip():
        print("⚠ OMASHIKI_WORKER_TOKEN is not set: no worker can poll this manager. "
              "Put it in .env.", flush=True)

mix("phx.server", distributed=True)
