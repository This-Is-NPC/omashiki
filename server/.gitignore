# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/


# Local env files — contain secrets, never commit.
.env
.env.local
.env.*.local

# JavaScript dependencies inside assets/
assets/node_modules/

# Fonts mirrored from assets/node_modules/@fontsource by
# `mix omashiki.assets.copy_fonts` (runs in `assets.build` /
# `assets.deploy`). Regenerable build artifact — keep out of git.
/priv/static/assets/files/

# Phoenix/Elixir tooling state.
/.elixir_ls/
/.dialyzer/
*.beam

# Local node debug logs.
npm-debug.log
yarn-error.log

# Release tarballs (built via `mix release`).
omashiki-*.tar.gz
