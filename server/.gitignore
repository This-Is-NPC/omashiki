# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/


# Local env files — contain secrets, never commit.
.env
.env.local
.env.*.local

# JavaScript dependencies inside assets/
assets/node_modules/

# Everything under priv/static/assets is build output, never source:
#   - app.css      `mix tailwind omashiki`
#   - app.js       `mix esbuild omashiki`
#   - files/       fonts mirrored from assets/node_modules/@fontsource by
#                  `mix omashiki.assets.copy_fonts`
# All three are produced by `mix assets.build` (dev) and `mix assets.deploy`
# (release — server/Dockerfile runs it before `mix release`), so no deployment
# path reads a committed copy. Keep them out of git: a committed bundle is a
# snapshot of whichever profile built it last. The tracked `app.js` used to be
# dev-watcher output carrying an inline base64 source map of development
# sources — shipped to production, and reproducible by no build target.
/priv/static/assets/

# Digested asset cache, written by `mix phx.digest` during `assets.deploy`.
/priv/static/cache_manifest.json

# Phoenix/Elixir tooling state.
/.elixir_ls/
/.dialyzer/
*.beam

# Local node debug logs.
npm-debug.log
yarn-error.log

# Release tarballs (built via `mix release`).
omashiki-*.tar.gz
