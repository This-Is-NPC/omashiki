#!/bin/sh
# Issues, lists, and revokes API tokens and sets their webhook.
# The release form of `mix omashiki.token`: same arguments, same output.
# Run `bin/token` with no arguments for the usage.
set -e

cd "$(dirname "$0")/.."

exec ./bin/omashiki eval 'Omashiki.Cli.run(Omashiki.Cli.Token, System.argv())' "$@"
