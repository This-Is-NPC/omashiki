# Optional environment variables loaded by test_helper.exs when running
# ExUnit. Copy this file to `.env` only for local test overrides.
#
# Nothing here is loaded in dev or prod — runtime.exs handles those.

# Docker image tag used by the real_opencode integration test. Default
# matches the production tag used by `ContainerManager`. Override if you
# want to exercise a local/dev image.
AGENT_IMAGE=omashiki/agent:latest

# -----------------------------------------------------------------------------
# Cloak field-level encryption (optional in dev; required in prod)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# In dev, leaving this blank lets `config/dev.exs` auto-generate a key into
# .omashiki/cloak_key on first boot. In prod, runtime.exs raises if missing.
OMASHIKI_CLOAK_KEY=
