<header class="bg-surface-container-lowest border-b border-outline-variant px-4 sm:px-6 lg:px-8">
  <%!-- The account block wraps under the logo and nav when one row cannot
        hold all three, so the nav always stays a single row. --%>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3 text-sm sm:py-4">
    <div class="flex items-center gap-5 sm:gap-8">
      <a
        href="/"
        class="font-headline italic text-xl text-primary-container tracking-tight"
      >
        Omashiki
      </a>
      <nav class="flex items-center gap-4 sm:gap-6" aria-label="Primary">
        <.link
          navigate="/"
          class={nav_link_class(:home, assigns)}
          aria-current={if assigns[:active_tab] == :home, do: "page", else: nil}
        >
          Home
        </.link>
        <.link
          navigate="/system"
          class={nav_link_class(:system, assigns)}
          aria-current={if assigns[:active_tab] == :system, do: "page", else: nil}
        >
          System
        </.link>
        <.link
          navigate="/config"
          class={nav_link_class(:config, assigns)}
          aria-current={if assigns[:active_tab] == :config, do: "page", else: nil}
        >
          Config
        </.link>
      </nav>
    </div>

    <%= if assigns[:current_user] do %>
      <div class="ml-auto flex items-center gap-4 shrink-0">
        <span
          class="font-label text-label-md tracking-[0.3em] uppercase text-on-surface max-w-[12rem] truncate inline-block"
          title={@current_user.username}
        >
          {@current_user.username}
        </span>
        <span class="text-outline-variant" aria-hidden="true">·</span>
        <form action="/logout" method="post" class="inline">
          <input type="hidden" name="_method" value="delete" />
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <button
            type="submit"
            class="font-label text-label-md tracking-[0.3em] uppercase px-3 py-1 pointer-coarse:min-h-10 transition-colors text-status-failed border border-status-failed/40 hover:border-status-failed hover:bg-status-failed/10"
          >
            Sign out
          </button>
        </form>
      </div>
    <% end %>
  </div>
</header>
<main class={[
  "bg-surface",
  if(assigns[:fluid_layout],
    do: "p-0 flex-1 min-h-0",
    else: "px-4 py-8 sm:px-6 lg:px-8"
  )
]}>
  <div class={
    cond do
      assigns[:fluid_layout] -> "w-full h-full flex flex-col min-h-0"
      # Full width with the normal page padding and document scroll. Unlike
      # fluid_layout it needs no root-layout body classes, which a live
      # navigation between screens would leave stale.
      assigns[:wide_layout] -> "w-full"
      true -> "mx-auto max-w-7xl"
    end
  }>
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
